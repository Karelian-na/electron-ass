{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "typescript",
			"tsconfig": "tsconfig.json",
			"label": "Build electron-ass in watch mode",
			"option": "watch",
			"problemMatcher": [
				"$tsc-watch"
			],
			"group": "build"
		},
		{
			"type": "npm",
			"script": "dev-example",
			"label": "Build and start example",
			"isBackground": true,
			"dependsOn": [
				"Build electron-ass in watch mode"
			],
			"options": {
				"env": {
					"mode": "development",
					"ELECTRON_GET_USE_PROXY": "true",
					"ELECTRON_MAIN_DEBUG_PORT": "9229"
				}
			},
			"problemMatcher": {
				"owner": "custom",
				"fileLocation": [
					"relative",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(?!x)x$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": ".*Debugger listening on .*:9229/.*"
				}
			}
		}
	],
}