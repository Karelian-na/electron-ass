{
	"compilerOptions": {
		"baseUrl": ".",
		"checkJs": true,
		"noEmitOnError": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"target": "esnext",
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"noImplicitThis": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"experimentalDecorators": true,
		"declaration": true,
		"sourceMap": true,
	}
}